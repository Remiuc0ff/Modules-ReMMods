from herokutl.types import Message
from .. import loader, utils
import os
import re
import aiohttp

@loader.tds
class TikTokMod(loader.Module):
    """Модуль для скачивания видео и аудио с ТТ по ссылке (без yt-dlp)"""
    
    strings = {
        "name": "TikTok",
        "downloading": "<tg-emoji emoji-id=5404857686477015710>🔄</tg-emoji> Скачиваю видео...",
        "downloading_audio": "<tg-emoji emoji-id=5408850846421124323>🎵</tg-emoji> Скачиваю аудио...",
        "uploading": "<tg-emoji emoji-id=5408942187490610930>🚀</tg-emoji> Загружаю...",
        "uploading_audio": "<tg-emoji emoji-id=5330541850174457854>🎶</tg-emoji> Загружаю аудио...",
        "error": "<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> Ошибка: {}",
        "no_link": "<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> Укажите ссылку на TikTok\nИспользование: .tt <ссылка> или реплай",
        "no_link_audio": "<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> Укажите ссылку на TikTok\nИспользование: .ttsound <ссылка> или реплай",
    }
    strings_ru = strings

    def _sanitize_filename(self, name: str) -> str:
        name = re.sub(r'[<>:"/\\|?*]', '', name)
        name = name.strip()
        if len(name) > 100:
            name = name[:100]
        return name if name else "tiktok_media"

    async def _get_url(self, message: Message) -> str:
        args = utils.get_args_raw(message)
        if args:
            return args.strip()
        
        reply = await message.get_reply_message()
        if reply and reply.text:
            urls = re.findall(r'https?://(?:vt\.|vm\.|www\.)?tiktok\.com/\S+', reply.text)
            if urls:
                return urls[0]
        
        return None

    async def _download(self, url: str, extract_audio: bool = False) -> tuple[str, str]:
        api_url = "https://www.tikwm.com/api/"
        
        async with aiohttp.ClientSession() as session:
            async with session.post(api_url, data={"url": url}) as response:
                json_data = await response.json()
                
                if json_data.get("code") != 0:
                    return None, None
                    
                item = json_data.get("data", {})
                title = item.get("title", "TikTok Video")
                
                if extract_audio:
                    media_url = item.get("music")
                    ext = "mp3"
                else:
                    media_url = item.get("play")
                    ext = "mp4"
                    
                if not media_url:
                    return None, None
                    
                temp_file = f"temp_tiktok.{ext}"
                
                async with session.get(media_url) as media_response:
                    with open(temp_file, "wb") as f:
                        f.write(await media_response.read())
                        
                return temp_file, title

    @loader.command(ru_doc="Скачать видео с TikTok")
    async def ttcmd(self, message: Message):
        """<link/reply> - Скачать видео с TikTok"""
        url = await self._get_url(message)
        if not url:
            await utils.answer(message, self.strings("no_link", message))
            return

        reply = await message.get_reply_message()
        reply_to_id = reply.id if reply else message.id

        msg = await utils.answer(message, self.strings("downloading", message))
        
        try:
            file_path, title = await self._download(url, extract_audio=False)
            if not file_path:
                raise Exception("Не удалось получить видео (Возможно, неверная ссылка или закрытый аккаунт)")
            
            await utils.answer(msg, self.strings("uploading", message))
            
            await message.client.send_file(
                message.to_id, 
                file_path, 
                reply_to=reply_to_id
            )
            await msg.delete()
            
        except Exception as e:
            await utils.answer(msg, self.strings("error", message).format(str(e)))
        finally:
            if 'file_path' in locals() and file_path and os.path.exists(file_path):
                os.remove(file_path)

    @loader.command(ru_doc="Скачать звук с TikTok")
    async def ttsoundcmd(self, message: Message):
        """<link/reply> - Скачать звук с TikTok"""
        url = await self._get_url(message)
        if not url:
            await utils.answer(message, self.strings("no_link_audio", message))
            return

        reply = await message.get_reply_message()
        reply_to_id = reply.id if reply else message.id

        msg = await utils.answer(message, self.strings("downloading_audio", message))
        
        try:
            file_path, title = await self._download(url, extract_audio=True)
            if not file_path:
                raise Exception("Не удалось получить аудио (Возможно, неверная ссылка)")
            
            await utils.answer(msg, self.strings("uploading_audio", message))
            
            await message.client.send_file(
                message.to_id, 
                file_path, 
                reply_to=reply_to_id
            )
            await msg.delete()
            
        except Exception as e:
            await utils.answer(msg, self.strings("error", message).format(str(e)))
        finally:
            if 'file_path' in locals() and file_path and os.path.exists(file_path):
                os.remove(file_path)
