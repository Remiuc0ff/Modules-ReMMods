from .. import loader, utils
import asyncio
import time
from telethon.errors.rpcerrorlist import YouBlockedUserError
from telethon.errors import UserNotParticipantError, UserAlreadyParticipantError
from telethon.tl.functions.messages import ImportChatInviteRequest
from telethon.tl.functions.channels import JoinChannelRequest, GetParticipantRequest
from telethon.tl.functions.account import UpdateNotifySettingsRequest
from telethon.tl.types import InputPeerNotifySettings
from telethon.utils import get_peer_id

@loader.tds
class YtBotBypassMod(loader.Module):
    """Мощное скачивание через бота с безопасной авто-отпиской и умной очисткой"""
    strings = {"name": "YtBotBypass"}
    __author__ = "@remiuc"
    __version__ = (1, 8, 7)

    def __init__(self):
        self.config = loader.ModuleConfig(
            "bot_username", "@SaveYoutubeBot", "Юзернейм бота для скачивания (@SaveYoutubeBot или @youtubabot)"
        )

    async def client_ready(self, client, db):
        self.db = db

    async def _process_download(self, message, url, msg, target_format):
        bot_username = self.config["bot_username"]
        sponsors = [] 
        processed_msgs = set()
        
        try:
            sent_msg = await message.client.send_message(bot_username, url)
            menu_msg = None
            
            for _ in range(20):
                msgs = await message.client.get_messages(bot_username, limit=5)
                for m in msgs:
                    if m.id <= sent_msg.id:
                        continue
                        
                    text_lower = (m.message or "").lower()
                    if "ошибк" in text_lower or "не найден" in text_lower:
                        await utils.answer(msg, f'<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Ошибка бота:</b>\n{m.message}')
                        return

                    if not m.buttons:
                        continue

                    is_sponsor = False
                    urls_to_join = []
                    check_btn = None
                    
                    for row in m.buttons:
                        for btn in row:
                            if getattr(btn, 'url', None):
                                urls_to_join.append(btn.url)
                            if btn.text and ("проверить" in btn.text.lower() or "check" in btn.text.lower() or "подписался" in btn.text.lower()):
                                check_btn = btn
                                is_sponsor = True
                                
                    if is_sponsor and m.id not in processed_msgs:
                        await utils.answer(msg, '<tg-emoji emoji-id="5411236022149219263">⚙️</tg-emoji> <b>Обнаружены спонсоры! Подписываюсь...</b>')
                        for sp_url in urls_to_join:
                            try:
                                chat_id = None
                                if "+" in sp_url or "joinchat" in sp_url:
                                    hash_str = sp_url.split("/")[-1].replace("+", "")
                                    try:
                                        updates = await message.client(ImportChatInviteRequest(hash_str))
                                        if updates.chats:
                                            chat_id = get_peer_id(updates.chats[0])
                                            sponsors.append(chat_id)
                                    except UserAlreadyParticipantError: pass
                                else:
                                    entity = sp_url.split("/")[-1]
                                    already_in = False
                                    try:
                                        await message.client(GetParticipantRequest(channel=entity, participant='me'))
                                        already_in = True
                                    except: pass
                                    if not already_in:
                                        updates = await message.client(JoinChannelRequest(entity))
                                        if updates.chats:
                                            chat_id = get_peer_id(updates.chats[0])
                                            sponsors.append(chat_id)
                                if chat_id:
                                    await message.client.edit_folder(chat_id, 1)
                                    await message.client(UpdateNotifySettingsRequest(
                                        peer=chat_id, settings=InputPeerNotifySettings(mute_until=2147483647)
                                    ))
                            except: pass
                            
                        await check_btn.click()
                        processed_msgs.add(m.id)
                        await asyncio.sleep(2)
                        break 

                    if "язык" in text_lower and m.id not in processed_msgs:
                        lang_clicked = False
                        for row in m.buttons:
                            for btn in row:
                                if "ru" in btn.text.lower() or "рус" in btn.text.lower():
                                    await btn.click()
                                    await utils.answer(msg, '<tg-emoji emoji-id="5411236022149219263">⚙️</tg-emoji> <b>Выбираю русскую озвучку...</b>')
                                    lang_clicked = True
                                    processed_msgs.add(m.id)
                                    break
                            if lang_clicked: break
                        if lang_clicked:
                            await asyncio.sleep(1.5)
                            break

                    is_main_menu = False
                    for row in m.buttons:
                        for btn in row:
                            btn_text = btn.text.lower()
                            if "p" in btn_text or "mp3" in btn_text or "мр3" in btn_text or "превью" in btn_text or "обрезка" in btn_text:
                                is_main_menu = True
                                break
                    if is_main_menu:
                        menu_msg = m
                        break
                        
                if menu_msg:
                    break
                await asyncio.sleep(1)

            clicked = False
            
            if menu_msg:
                await utils.answer(msg, '<tg-emoji emoji-id="5411236022149219263">⚙️</tg-emoji> <b>Меню получено. Выбираю формат...</b>')
                
                if target_format == "video":
                    formats_to_try = ["720", "480", "360", "240", "144"]
                elif target_format == "audio":
                    formats_to_try = ["mp3", "мр3"]
                elif target_format == "preview":
                    formats_to_try = ["превью"]
                    
                for fmt in formats_to_try:
                    format_too_big = False
                    for row in menu_msg.buttons:
                        for button in row:
                            if fmt in button.text.lower():
                                click_res = await button.click()
                                if click_res and click_res.message:
                                    msg_lower = click_res.message.lower()
                                    if "много одинаковых" in msg_lower or "запросов" in msg_lower:
                                        await utils.answer(msg, f'<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Ошибка бота:</b>\n{click_res.message}')
                                        return
                                    if "ограничен" in msg_lower or "размер" in msg_lower:
                                        await utils.answer(msg, f'<tg-emoji emoji-id="5411236022149219263">⚙️</tg-emoji> <b>Размер для {fmt} превышает лимит. Пробую качество ниже...</b>')
                                        format_too_big = True
                                        break
                                clicked = True
                                await utils.answer(msg, f'<tg-emoji emoji-id="5411192149058289173">☁️</tg-emoji> <b>Нажал {fmt}! Ожидаю файл...</b>')
                                break
                        if clicked or format_too_big: break
                    if clicked: break

                if not clicked:
                    for row in menu_msg.buttons:
                        for button in row:
                            btn_text = button.text.lower().replace("м", "m").replace("р", "p")
                            if (target_format == "video" and "p" in btn_text) or \
                               (target_format == "audio" and "mp3" in btn_text) or \
                               (target_format == "preview" and "превью" in btn_text):
                                click_res = await button.click()
                                clicked = True
                                await utils.answer(msg, '<tg-emoji emoji-id="5411192149058289173">☁️</tg-emoji> <b>Нажал запасную кнопку. Ожидаю файл...</b>')
                                break
                        if clicked: break
            else:
                await utils.answer(msg, '<tg-emoji emoji-id="5411192149058289173">☁️</tg-emoji> <b>Меню не найдено, жду файл напрямую...</b>')

            if menu_msg and not clicked and target_format != "none":
                 await utils.answer(msg, '<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>В меню нет нужного формата!</b>')
                 return

            start_time = time.time()
            while True:
                if time.time() - start_time > 300:
                    await utils.answer(msg, '<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Таймаут. Бот не отдал файл.</b>')
                    break
                    
                msgs = await message.client.get_messages(bot_username, limit=10)
                found = False
                
                for m in msgs:
                    # Разрешаем перехват любого файла, отправленного ПОСЛЕ нашей ссылки
                    if m.id <= sent_msg.id:
                        continue
                        
                    text_lower = (m.message or "").lower()
                    if "безлимит" in text_lower or "закрепи" in text_lower or "ожидайте" in text_lower or "загрузка" in text_lower:
                        continue
                        
                    # Обрабатываем кнопки "проверить подписку", если они вылезли после выбора качества
                    if m.buttons and m.id not in processed_msgs:
                        action_taken = False
                        for row in m.buttons:
                            for btn in row:
                                btn_text = (btn.text or "").lower()
                                if "ru" in btn_text or "рус" in btn_text:
                                    await btn.click()
                                    await utils.answer(msg, '<tg-emoji emoji-id="5411236022149219263">⚙️</tg-emoji> <b>Автоматически выбрана русская озвучка...</b>')
                                    action_taken = True
                                    break
                                elif "проверить" in btn_text or "check" in btn_text or "подписался" in btn_text:
                                    await btn.click()
                                    action_taken = True
                                    break
                            if action_taken: break
                        if action_taken:
                            processed_msgs.add(m.id)
                            await asyncio.sleep(1.5)
                            continue

                    if m and getattr(m, 'media', None):
                        # Игнорируем превью обычных ссылок
                        if hasattr(m.media, 'webpage') and getattr(m.media, 'webpage', None):
                            continue
                            
                        is_valid = False
                        if target_format == "video" and (getattr(m, 'video', None) or getattr(m, 'document', None)):
                            is_valid = True
                        elif target_format == "audio" and (getattr(m, 'audio', None) or getattr(m, 'voice', None) or getattr(m, 'document', None)):
                            is_valid = True
                        elif target_format == "preview" and (getattr(m, 'photo', None) or getattr(m, 'document', None)):
                            # Чтобы скрипт не перехватил рекламный фото-баннер вместо превью
                            if "доступ к боту" not in text_lower:
                                is_valid = True
                            
                        if is_valid:
                            await self._send_media(message, m, msg)
                            found = True
                            break
                
                if found:
                    try:
                        async for old_m in message.client.iter_messages(bot_username, limit=50):
                            await old_m.delete()
                    except: pass
                    break
                    
                await asyncio.sleep(2)

        except YouBlockedUserError:
            await utils.answer(msg, f'<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Разблокируй {bot_username}!</b>')
        except Exception as e:
            await utils.answer(msg, f'<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Ошибка модуля:</b> {str(e)}')
        finally:
            if sponsors:
                await asyncio.sleep(2)
                for sp in sponsors:
                    try:
                        entity = await message.client.get_entity(sp)
                        await message.client.delete_dialog(entity)
                    except:
                        try:
                            await message.client.delete_dialog(sp)
                        except: pass

    async def _send_media(self, message, media_msg, msg):
        await utils.answer(msg, '<tg-emoji emoji-id="5330349014732802482">🚀</tg-emoji> <b>Файл перехвачен! Загружаю в чат...</b>')
        await message.client.send_file(
            message.chat_id,
            file=media_msg,
            caption='<tg-emoji emoji-id="5332366494015715581">💎</tg-emoji> <b>Успешно загружено</b>',
            reply_to=message.id
        )
        if msg.out:
            await msg.delete()

    async def ytcmd(self, message):
        """<ссылка> - Скачать видео через бота-посредника"""
        args = utils.get_args_raw(message)
        if not args:
            return await utils.answer(message, '<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Укажи ссылку!</b>')
        msg = await utils.answer(message, '<tg-emoji emoji-id="5332688668102525212">⏳</tg-emoji> <b>Отправляю запрос...</b>')
        await self._process_download(message, args.strip(), msg[0] if isinstance(msg, list) else msg, target_format="video")

    async def ytaudiocmd(self, message):
        """<ссылка> - Скачать аудио через бота-посредника"""
        args = utils.get_args_raw(message)
        if not args:
            return await utils.answer(message, '<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Укажи ссылку!</b>')
        msg = await utils.answer(message, '<tg-emoji emoji-id="5408850846421124323">🎵</tg-emoji> <b>Отправляю запрос...</b>')
        await self._process_download(message, args.strip(), msg[0] if isinstance(msg, list) else msg, target_format="audio")

    async def ytpreviewcmd(self, message):
        """<ссылка> - Скачать превью видео через бота-посредника"""
        args = utils.get_args_raw(message)
        if not args:
            return await utils.answer(message, '<tg-emoji emoji-id="5408830797513784663">🚫</tg-emoji> <b>Укажи ссылку!</b>')
        msg = await utils.answer(message, '<tg-emoji emoji-id="5332688668102525212">🖼</tg-emoji> <b>Отправляю запрос на превью...</b>')
        await self._process_download(message, args.strip(), msg[0] if isinstance(msg, list) else msg, target_format="preview")
