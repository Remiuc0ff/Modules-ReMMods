import asyncio
import math
import os
import shutil
import tempfile
from telethon.tl.types import Message
from .. import loader, utils


@loader.tds
class TwitchVODMod(loader.Module):
    """Скачивает записи стримов (VOD) с Twitch в 1080p с авто-нарезкой под лимиты Telegram"""

    strings = {
        "name": "TwitchVOD",
        "no_url": "🚫 <b>Укажи ссылку на запись стрима Twitch.</b>\nПример: <code>.tvod https://www.twitch.tv/videos/123456789</code>",
        "no_ffmpeg": "🚫 <b>На сервере не установлен <code>ffmpeg</code>.</b> Установи его: <code>sudo apt install ffmpeg</code>",
        "downloading": "⏳ <b>Скачиваю запись стрима в {}p...</b>\n<i>Для длинных стримов (3–6ч) это может занять много времени.</i>",
        "splitting": "✂️ <b>Файл весит {:.2f} ГБ.</b>\nНарезаю на {} ч. без потери качества...",
        "uploading": "📤 <b>Загружаю в Telegram ({}/{})...</b>",
        "done": "✅ <b>Готово!</b> Запись полностью загружена.",
        "error": "❌ <b>Ошибка:</b>\n<code>{}</code>",
    }

    def __init__(self):
        self.config = loader.ModuleConfig(
            loader.ConfigValue(
                "max_chunk_mb",
                1900,
                "Макс. размер одной части в МБ (1900 для обычного ТГ, 3900 для Premium)",
                validator=loader.validators.Integer(minimum=100, maximum=3950),
            ),
            loader.ConfigValue(
                "quality",
                1080,
                "Максимальное разрешение видео (например, 1080 или 720)",
                validator=loader.validators.Integer(minimum=360, maximum=2160),
            ),
        )

    async def _run_cmd(self, *args) -> tuple[int, str, str]:
        proc = await asyncio.create_subprocess_exec(
            *args,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )
        stdout, stderr = await proc.communicate()
        return proc.returncode, stdout.decode(errors="ignore"), stderr.decode(errors="ignore")

    async def _get_duration(self, filepath: str) -> float:
        code, out, _ = await self._run_cmd(
            "ffprobe",
            "-v", "error",
            "-show_entries", "format=duration",
            "-of", "default=noprint_wrappers=1:nokey=1",
            filepath,
        )
        if code == 0 and out.strip():
            return float(out.strip())
        return 0.0

    @loader.command(ru_doc="<ссылка> - Скачать запись стрима Twitch в 1080p")
    async def tvod(self, message: Message):
        """<url> - Download Twitch VOD in 1080p"""
        url = utils.get_args_raw(message).strip()
        if not url:
            await utils.answer(message, self.strings["no_url"])
            return

        if not shutil.which("ffmpeg") or not shutil.which("ffprobe"):
            await utils.answer(message, self.strings["no_ffmpeg"])
            return

        quality = self.config["quality"]
        max_chunk_bytes = self.config["max_chunk_mb"] * 1024 * 1024

        status_msg = await utils.answer(
            message, self.strings["downloading"].format(quality)
        )

        temp_dir = tempfile.mkdtemp(prefix="tvod_")
        output_template = os.path.join(temp_dir, "vod.%(ext)s")

        try:
            # Скачивание через yt-dlp с многопоточной загрузкой фрагментов (-N 8)
            fmt = f"bestvideo[height<={quality}]+bestaudio/best[height<={quality}]/best"
            code, _, err = await self._run_cmd(
                "yt-dlp",
                "-f", fmt,
                "--merge-output-format", "mp4",
                "-N", "8",
                "--no-playlist",
                "-o", output_template,
                url,
            )

            if code != 0:
                await utils.answer(status_msg, self.strings["error"].format(err[-1000:]))
                return

            # Ищем скачанный файл
            files = [
                os.path.join(temp_dir, f)
                for f in os.listdir(temp_dir)
                if f.startswith("vod.")
            ]
            if not files:
                await utils.answer(status_msg, self.strings["error"].format("Файл не найден после загрузки."))
                return

            video_path = files[0]
            file_size = os.path.getsize(video_path)
            parts_to_send = []

            if file_size > max_chunk_bytes:
                duration = await self._get_duration(video_path)
                num_parts = math.ceil(file_size / max_chunk_bytes)
                # Небольшой запас по времени, чтобы части точно влезли в лимит
                segment_time = max(60, int(duration / num_parts * 0.95))

                await utils.answer(
                    status_msg,
                    self.strings["splitting"].format(file_size / (1024**3), num_parts),
                )

                part_pattern = os.path.join(temp_dir, "part_%03d.mp4")
                s_code, _, s_err = await self._run_cmd(
                    "ffmpeg",
                    "-i", video_path,
                    "-c", "copy",
                    "-map", "0",
                    "-segment_time", str(segment_time),
                    "-f", "segment",
                    "-reset_timestamps", "1",
                    part_pattern,
                )

                if s_code != 0:
                    await utils.answer(status_msg, self.strings["error"].format(s_err[-1000:]))
                    return

                # Удаляем исходник сразу после нарезки, чтобы освободить место
                os.remove(video_path)

                parts_to_send = sorted(
                    os.path.join(temp_dir, f)
                    for f in os.listdir(temp_dir)
                    if f.startswith("part_")
                )
            else:
                parts_to_send = [video_path]

            total = len(parts_to_send)
            for idx, part_path in enumerate(parts_to_send, start=1):
                await utils.answer(
                    status_msg, self.strings["uploading"].format(idx, total)
                )
                caption = f"🎥 <b>Twitch VOD</b> ({quality}p)"
                if total > 1:
                    caption += f" — Часть {idx}/{total}"

                await self._client.send_file(
                    message.chat_id,
                    part_path,
                    caption=caption,
                    supports_streaming=True,
                )
                # Удаляем отправленную часть сразу
                os.remove(part_path)

            await utils.answer(status_msg, self.strings["done"])

        except Exception as e:
            await utils.answer(status_msg, self.strings["error"].format(str(e)))
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
