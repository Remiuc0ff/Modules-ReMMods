import asyncio
from telethon.tl.functions.contacts import BlockRequest, UnblockRequest
from telethon.errors import FloodWaitError
from .. import loader, utils

@loader.tds
class ChatMassBlockMod(loader.Module):
    """Модуль для массового добавления/удаления из личного ЧС участников чата по ID"""
    strings = {
        "name": "MassBlock",
        "no_id": "<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> <b>Ошибка:</b> Укажите ID группы!\nПример: <code>.blockall -100123456789</code>",
        "invalid_id": "<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> <b>Ошибка:</b> Неверный формат ID или у вас нет доступа к этому чату.",
        
        "starting": "<tg-emoji emoji-id=5332688668102525212>⌛</tg-emoji> <b>Начинаю сбор участников...</b>\nЭто может занять время. Не перезагружайте юзербот.",
        "progress": "<tg-emoji emoji-id=5404857686477015710>🔄</tg-emoji> <b>Блокировка в процессе...</b>\nЗаблокировано: <code>{}</code>\nОшибок/Пропущено: <code>{}</code>",
        "finished": "<tg-emoji emoji-id=5409234309691244951>✅</tg-emoji> <b>Готово!</b>\n\nУспешно добавлено в ЧС: <code>{}</code> пользователей.\nПропущено: <code>{}</code>",
        
        "starting_unblock": "<tg-emoji emoji-id=5332688668102525212>⌛</tg-emoji> <b>Начинаю сбор участников для разблокировки...</b>\nЭто может занять время.",
        "progress_unblock": "<tg-emoji emoji-id=5404857686477015710>🔄</tg-emoji> <b>Разблокировка в процессе...</b>\nРазблокировано: <code>{}</code>\nОшибок/Пропущено: <code>{}</code>",
        "finished_unblock": "<tg-emoji emoji-id=5409234309691244951>✅</tg-emoji> <b>Готово!</b>\n\nУспешно убрано из ЧС: <code>{}</code> пользователей.\nПропущено: <code>{}</code>",
    }
    strings_ru = strings

    @loader.command(ru_doc="<ID> - Добавить всех участников указанного чата в личный ЧС")
    async def blockallcmd(self, message):
        """Использование: .blockall <ID чата>"""
        args = utils.get_args_raw(message)
        
        if not args:
            await utils.answer(message, self.strings("no_id", message))
            return
            
        try:
            target_chat_id = int(args.strip())
        except ValueError:
            await utils.answer(message, self.strings("invalid_id", message))
            return

        msg = await utils.answer(message, self.strings("starting", message))
        
        blocked_count = 0
        skipped_count = 0
        
        try:
            chat = await message.client.get_entity(target_chat_id)
            
            async for user in message.client.iter_participants(chat):
                if user.is_self or user.bot or user.deleted:
                    skipped_count += 1
                    continue
                
                try:
                    await message.client(BlockRequest(id=user.id))
                    blocked_count += 1
                    
                    if blocked_count % 5 == 0:
                        await utils.answer(
                            msg, 
                            self.strings("progress", message).format(blocked_count, skipped_count)
                        )
                        
                    await asyncio.sleep(5)
                    
                except FloodWaitError as e:
                    await asyncio.sleep(e.seconds + 2)
                except Exception:
                    skipped_count += 1

        except Exception as e:
            await utils.answer(msg, f"<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> <b>Критическая ошибка:</b> {str(e)}\nУбедитесь, что ID верный и вы состоите в этом чате.")
            return

        await utils.answer(msg, self.strings("finished", message).format(blocked_count, skipped_count))

    @loader.command(ru_doc="<ID> - Убрать всех участников указанного чата из личного ЧС")
    async def unblockallcmd(self, message):
        """Использование: .unblockall <ID чата>"""
        args = utils.get_args_raw(message)
        
        if not args:
            await utils.answer(message, self.strings("no_id", message))
            return
            
        try:
            target_chat_id = int(args.strip())
        except ValueError:
            await utils.answer(message, self.strings("invalid_id", message))
            return

        msg = await utils.answer(message, self.strings("starting_unblock", message))
        
        unblocked_count = 0
        skipped_count = 0
        
        try:
            chat = await message.client.get_entity(target_chat_id)
            
            async for user in message.client.iter_participants(chat):
                if user.is_self or user.bot or user.deleted:
                    skipped_count += 1
                    continue
                
                try:
                    await message.client(UnblockRequest(id=user.id))
                    unblocked_count += 1
                    
                    if unblocked_count % 5 == 0:
                        await utils.answer(
                            msg, 
                            self.strings("progress_unblock", message).format(unblocked_count, skipped_count)
                        )
                        
                    await asyncio.sleep(5)
                    
                except FloodWaitError as e:
                    await asyncio.sleep(e.seconds + 2)
                except Exception:
                    skipped_count += 1

        except Exception as e:
            await utils.answer(msg, f"<tg-emoji emoji-id=5408830797513784663>🚫</tg-emoji> <b>Критическая ошибка:</b> {str(e)}\nУбедитесь, что ID верный и вы состоите в этом чате.")
            return

        await utils.answer(msg, self.strings("finished_unblock", message).format(unblocked_count, skipped_count))
