    async def nyash(self, message: Message):
        """Включить / выключить авто-няшность сообщений"""
        state = not self.get("enabled", False)
        self.set("enabled", state)
        await utils.answer(
            message,
            self.strings("on") if state else self.strings("off"),
        )

    @loader.command()
    async def nyashreload(self, message: Message):
        """Перезагрузить премиум-эмодзи из паков в конфиге"""
        await self._fetch_emoji_packs()
        await utils.answer(
            message,
            self.strings("reloaded").format(count=len(self.premium_emojis)),
        )

    @loader.command()
    async def nyashstats(self, message: Message):
        """Показать статистику словаря и комбинаций"""
        keys_count = len(self.cute_dict)
        variants_count = sum(len(v) for v in self.cute_dict.values())
        suffixes_count = len(self.sound_roots) * len(self.sound_connectors) * len(self.emoticon_tails)
        await utils.answer(
            message,
            self.strings("stats").format(
                keys=keys_count,
                variants=variants_count,
                suffixes=suffixes_count,
                emojis=len(self.premium_emojis),
            ),
        )

    @loader.command()
    async def nyashtest(self, message: Message):
        """<текст> — Проверить перевод фразы без включения авто-режима"""
        args = utils.get_args_raw(message)
        if not args:
            args = "Привет! Как дела? Я сейчас устал писать код, пойду спать. Спасибо за помощь, друг!"
        await utils.answer(message, self._nyashify_text(args))

    @loader.watcher(out=True, only_messages=True)
    async def watcher(self, message: Message):
        if not self.get("enabled", False):
            return

        if not message.text or message.fwd_from:
            return

        prefix = self.get_prefix()
        if (
            message.text.startswith(prefix)
            or message.text.startswith("/")
            or "http://" in message.text
            or "https://" in message.text
            or "```" in message.text
        ):
            return

        new_text = self._nyashify_text(message.text)

        if new_text != message.text:
            try:
                await message.edit(new_text, parse_mode="html")
            except Exception:
                pass
