    async def client_ready(self, client, db):
        self.db = db
        self.client = client
        await self._fetch_emoji_packs()

    async def _fetch_emoji_packs(self):
        loaded = []
        packs = self.config["emoji_packs"] or []

        for raw_pack in packs:
            short_name = raw_pack.strip().rstrip("/").split("/")[-1]
            if not short_name:
                continue

            try:
                result = await self.client(
                    GetStickerSetRequest(
                        stickerset=InputStickerSetShortName(short_name=short_name),
                        hash=0,
                    )
                )
                for doc in result.documents:
                    fallback = "🌸"
                    for attr in doc.attributes:
                        if hasattr(attr, "alt") and attr.alt:
                            fallback = attr.alt
                            break
                    loaded.append((doc.id, fallback))
            except Exception:
                pass

        if loaded:
            self.premium_emojis = loaded

    def _generate_suffix(self) -> str:
        """Генерирует одну из 4500+ уникальных комбинаций звуков, тильд и сердечек."""
        if random.random() < 0.78:
            sound = random.choice(self.sound_roots)
            conn = random.choice(self.sound_connectors)
            tail = random.choice(self.emoticon_tails)
            return f" {sound}{conn}{tail}"
        else:
            # Иногда только тильда + смайл/сердечко
            conn = random.choice(["~", "~~", "~"])
            tail = random.choice([t for t in self.emoticon_tails if t])
            return f"{conn}{tail}"

    def _apply_smart_stutter(self, word: str) -> str:
        match = re.match(r"^([^\wА-Яа-яЁё]*)([А-Яа-яЁёA-Za-z]+)(.*)$", word)
        if not match:
            return word

        prefix, core, suffix = match.groups()
        if len(core) < 3 or core.isupper():
            return word

        first_char = core[0]
        if random.random() < 0.2:
            stuttered = f"{first_char}-{first_char.lower()}-{core.lower()}"
        else:
            stuttered = f"{first_char}-{core.lower()}"

        return f"{prefix}{stuttered}{suffix}"

    def _replace_dict_words(self, text: str) -> str:
        chance = self.config["dict_chance"]

        def replacer(match):
            word = match.group(0)
            lower_w = word.lower()
            if lower_w in self.cute_dict and random.random() < chance:
                choice = random.choice(self.cute_dict[lower_w])
                if word[0].isupper():
                    return choice[0].upper() + choice[1:]
                return choice
            return word

        return self._dict_pattern.sub(replacer, text)

    def _process_sentence(self, sentence: str) -> str:
        sentence = sentence.strip()
        if not sentence:
            return ""

        if self.config["soft_words"]:
            sentence = self._replace_dict_words(sentence)

        words = sentence.split(" ")
        if words and random.random() < self.config["stutter_chance"]:
            words[0] = self._apply_smart_stutter(words[0])
        sentence = " ".join(words)

        if self.config["replace_r"]:
            sentence = re.sub(r"(?<![рР])р(?=[аоуыэяёюие])", "в", sentence)
            sentence = re.sub(r"(?<![рР])Р(?=[аоуыэяёюие])", "В", sentence)

        if "," in sentence and random.random() < 0.45:
            parts = sentence.split(",", 1)
            sentence = f"{parts[0]}{random.choice(self.comma_inserts)} {parts[1].lstrip()}"

        if sentence.endswith("..."):
            sentence = sentence[:-3] + "~..."
        elif sentence.endswith("!"):
            sentence = sentence[:-1] + random.choice(["~!", "~ <3", "!!~", "~ мяу!", "~ ня!"])
        elif sentence.endswith("?"):
            sentence = sentence[:-1] + random.choice(["?~", "??~", "? uwu", "? мяу~", "? ня~"])
        elif sentence.endswith("."):
            sentence = sentence[:-1] + "~"
        else:
            if random.random() < 0.6:
                sentence += "~"

        return sentence

    def _nyashify_text(self, text: str) -> str:
        safe_text = utils.escape_html(text)
        lines = safe_text.split("\n")
        processed_lines = []

        for line in lines:
            if not line.strip():
                processed_lines.append(line)
                continue

            raw_sentences = re.split(r"(?<=[.!?])\s+", line)
            new_sentences = [self._process_sentence(s) for s in raw_sentences if s.strip()]
            processed_lines.append(" ".join(new_sentences))

        result = "\n".join(processed_lines)

        if random.random() < self.config["suffix_chance"]:
            suffix = utils.escape_html(self._generate_suffix())
            result += suffix

        if (
            self.config["use_premium_emoji"]
            and self.premium_emojis
            and random.random() < self.config["emoji_chance"]
        ):
            doc_id, fallback = random.choice(self.premium_emojis)
            result += f' <emoji document_id="{doc_id}">{fallback}</emoji>'

        return result

